# ================= Kênh chat (bật ít nhất 1) =================
# Telegram: tạo bot qua @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# ID Telegram của bạn (nhắn @userinfobot để lấy). Nhiều ID cách nhau bằng dấu phẩy.
TELEGRAM_ALLOWED_USER_IDS=

# Discord: https://discord.com/developers/applications → Bot → Reset Token
# Nhớ bật "Message Content Intent" trong tab Bot.
DISCORD_BOT_TOKEN=
# ID Discord của bạn (bật Developer Mode → chuột phải tên mình → Copy User ID)
DISCORD_ALLOWED_USER_IDS=

# ================= Model =================
# Thử lần lượt từ trái sang phải, model sau là dự phòng khi model trước lỗi/hết quota.
# Định dạng provider:model, provider = google | anthropic | ollama
MODEL_CHAIN=google:gemini-flash-latest,anthropic:claude-sonnet-5-5,ollama:qwen2.5:3b

# Gemini API key: https://aistudio.google.com/apikey
# (Gói Google AI Pro KHÔNG cộng quota cho API; chưa bật billing thì dùng free tier.)
GOOGLE_GENERATIVE_AI_API_KEY=
# Claude API key: https://console.anthropic.com → API Keys (trả theo mức dùng). Bỏ trống để tắt.
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# ================= Notion =================
# https://www.notion.so/profile/integrations → New integration → copy "Internal Integration Secret".
# Sau đó vào từng trang muốn bot thấy → ••• → Connections → thêm integration.
NOTION_TOKEN=
# Trang chứa ghi chú bot tạo ra (lấy ID 32 ký tự ở cuối URL trang)
NOTION_INBOX_PARENT_PAGE_ID=
# Trang chứa giáo án gym. Bỏ trống thì lưu file .md trong ./data/gym-plans
NOTION_GYM_PARENT_PAGE_ID=

# ================= Server =================
SHELL_ENABLED=true
SHELL_CWD=/home/john
SHELL_TIMEOUT_MS=30000

# ================= Chung =================
TZ_NAME=Asia/Ho_Chi_Minh
DB_PATH=./data/assistant.db
HISTORY_LIMIT=40
MAX_STEPS=8
ASSISTANT_NAME=Homelab
